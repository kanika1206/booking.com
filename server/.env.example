# Copy to server/.env. Local development values only.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://booking:booking_local_only@localhost:5433/booking
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
JWT_EXPIRES_IN_SECONDS=604800
CLIENT_ORIGIN=http://localhost:5173
BCRYPT_COST=12
# Business rules
TAX_RATE=0.12
CURRENCY=INR
MAX_STAY_NIGHTS=30
